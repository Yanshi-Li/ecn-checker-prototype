{
  "schema_version": "1.0.0",
  "catalogue_name": "ECN Checker Rules",
  "source": "docs/rules_origin.txt",
  "finding_contract": {
    "required": ["rule_id", "evaluation_status", "severity", "gate_effect", "source_engine", "message", "evidence"],
    "severity_values": ["BLOCKER", "WARNING", "ADVISORY"],
    "gate_effect_values": ["FAIL", "REVIEW", "NONE"]
  },
  "rules": [
    {"id":"H01","domain":"ECN_HEADER","scope":"ecn","evaluator":"deterministic","check":"required","field":"header.name_of_change","severity":"BLOCKER","gate_effect":"FAIL","message":"Name of Change is blank, mandatory field missing"},
    {"id":"H02","domain":"ECN_HEADER","scope":"ecn","evaluator":"deterministic","check":"string_constraints","field":"header.name_of_change","parameters":{"max_length":50,"forbidden_characters":["<",">",":","\"","/","\\","|","?","*"]},"severity":"BLOCKER","gate_effect":"FAIL","message":"Name of Change contains too many or unacceptable characters"},
    {"id":"H03","domain":"CHANGE_DESCRIPTION","scope":"ecn","evaluator":"deterministic","check":"required","field":"header.description_of_change","severity":"BLOCKER","gate_effect":"FAIL","message":"Description of Change is missing"},
    {"id":"H04","domain":"CHANGE_DESCRIPTION","scope":"ecn","evaluator":"semantic_heuristic","check":"description_quality","field":"header.description_of_change","parameters":{"minimum_length":51,"structured":true},"severity":"WARNING","gate_effect":"REVIEW","message":"Description is too short or lacks required paragraph structure"},
    {"id":"H05","domain":"CHANGE_DESCRIPTION","scope":"ecn","evaluator":"llm_advisory","check":"plain_english","field":"header.description_of_change","severity":"WARNING","gate_effect":"REVIEW","message":"Description contains non-English characters or Jargon-heavy words"},
    {"id":"H06","domain":"IMPLEMENTATION","scope":"ecn","evaluator":"deterministic","applies_when":{"field":"header.implementation.site","operator":"present"},"check":"required","field":"header.implementation.date","severity":"WARNING","gate_effect":"REVIEW","message":"Implementation Date is missing"},
    {"id":"H07","domain":"IMPLEMENTATION","scope":"ecn","evaluator":"deterministic","applies_when":{"field":"header.implementation.date","operator":"present"},"check":"date_not_in_past","field":"header.implementation.date","severity":"WARNING","gate_effect":"REVIEW","message":"Implementation Date is in the past, must be a future date"},
    {"id":"H08","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","check":"matches_header_assembly","fields":["bom.parent.part_number","header.products_affected"],"severity":"WARNING","gate_effect":"REVIEW","message":"Parent Part No. does not match the assembly listed in the ECN form"},
    {"id":"H09","domain":"BOM_LINE","scope":"bom_line","evaluator":"reference_lookup","applies_when":{"field":"bom.action","operator":"in","values":["REMOVE","REPLACE"]},"check":"exists_in_current_bom","fields":["bom.parent.part_number","bom.existing_child.part_number"],"reference":"reference.current_bom","severity":"BLOCKER","gate_effect":"FAIL","message":"Existing Child Part does not exist in current BOM, cannot be removed or replaced"},
    {"id":"H10","domain":"BOM_LINE","scope":"bom_line","evaluator":"reference_lookup","applies_when":{"field":"bom.action","operator":"equals","value":"ADD"},"check":"not_exists_in_current_bom","fields":["bom.parent.part_number","bom.new_child.part_number"],"reference":"reference.current_bom","severity":"BLOCKER","gate_effect":"FAIL","message":"New Child Part already exists in current BOM, cannot be added again"},
    {"id":"H11","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"field":"bom.action","operator":"not_in","values":["CLOSE","MASS_CLOSE"]},"check":"positive_decimal","field":"bom.quantity","parameters":{"minimum_exclusive":0,"maximum_decimal_places":5},"severity":"BLOCKER","gate_effect":"FAIL","message":"Quantity is zero when the ACTION is ADD; other quantities must be greater than zero, and rounded to no more than 5 decimal places"},
    {"id":"H12","domain":"BOM_LINE","scope":"assembly","evaluator":"deterministic","check":"no_duplicate_change_lines","fields":["bom.parent.part_number","bom.existing_child.part_number","bom.new_child.part_number"],"severity":"WARNING","gate_effect":"REVIEW","message":"Duplicate change lines detected for same part in same assembly"},
    {"id":"H13","domain":"PART_MASTER","scope":"bom_line","evaluator":"reference_lookup","check":"matches_reference_field","field":"bom.unit_of_measure","lookup_key":"bom.new_child.part_number","reference":"reference.parts.unit_of_measure","severity":"WARNING","gate_effect":"REVIEW","message":"Unit of measure does not match what is recorded in the Parts Master DB"},
    {"id":"H14","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","check":"forbidden_characters","field":"bom.new_child.description","parameters":{"characters":[" ",",","*"]},"severity":"BLOCKER","gate_effect":"FAIL","message":"Space, comma, and asterisk symbol is not acceptable","implementation_note":"Confirm that the intended field is part description, not part number."},
    {"id":"H15","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"left":"bom.new_child.drawing_number","operator":"equals_field","right":"bom.new_child.part_number"},"check":"matching_issues","fields":["bom.new_child.part_issue","bom.new_child.drawing_issue"],"parameters":{"max_length":2},"severity":"BLOCKER","gate_effect":"FAIL","message":"Part issue and drawing issue not matched"},
    {"id":"H16","domain":"CHANGE_DESCRIPTION","scope":"ecn","evaluator":"deterministic","check":"forbidden_terms","field":"header.description_of_change","parameters":{"terms":["fire","flood","shock","hazard"],"case_sensitive":false},"severity":"BLOCKER","gate_effect":"FAIL","message":"Avoid words \"fire\", \"flood\", \"shock\", \"hazard\""},
    {"id":"H17","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","check":"max_length","field":"bom.new_child.description","parameters":{"maximum":30},"severity":"WARNING","gate_effect":"REVIEW","message":"Avoid more than 30 characters"},
    {"id":"H18","domain":"IMPLEMENTATION","scope":"ecn","evaluator":"deterministic","applies_when":{"field":"header.implementation.date","operator":"present"},"check":"required","field":"header.implementation.person","severity":"WARNING","gate_effect":"REVIEW","message":"Implementation Person is missing"},
    {"id":"H19","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"field":"bom.parent.part_number","operator":"present"},"check":"required","field":"bom.parent.description","severity":"WARNING","gate_effect":"REVIEW","message":"Parent Description is missing"},
    {"id":"H20","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"field":"bom.action","operator":"not_in","values":["MASS_CLOSE","REPLACE","COPY_STRUCTURE"]},"check":"required","field":"bom.task_number","severity":"BLOCKER","gate_effect":"FAIL","message":"Task Number is missing"},
    {"id":"H21","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"field":"bom.existing_child.part_number","operator":"present"},"check":"required","field":"bom.existing_child.description","severity":"BLOCKER","gate_effect":"FAIL","message":"Existing Child Description is missing"},
    {"id":"H22","domain":"BOM_LINE","scope":"bom_line","evaluator":"deterministic","applies_when":{"field":"bom.new_child.part_number","operator":"present"},"check":"required","field":"bom.new_child.description","severity":"BLOCKER","gate_effect":"FAIL","message":"New Child Description is missing"},
    {"id":"H23","domain":"CHANGE_DESCRIPTION","scope":"ecn","evaluator":"semantic_heuristic","check":"term_threshold","field":"header.description_of_change","parameters":{"terms":["electrical","water","safety concern"],"minimum_matches":2},"severity":"WARNING","gate_effect":"REVIEW","message":"Words \"electrical\", \"water\", \"safety concern\" need to be checked, better to change to others"},
    {"id":"S01","domain":"SEMANTIC_ALIGNMENT","scope":"description_to_bom","evaluator":"llm_advisory","check":"description_matches_bom_actions","fields":["header.description_of_change","bom.action"],"severity":"ADVISORY","gate_effect":"NONE","message":"The meaning between description of change and BOM is different"},
    {"id":"S02","domain":"SEMANTIC_ALIGNMENT","scope":"description_to_bom","evaluator":"semantic_heuristic","check":"mentioned_parts_exist_in_bom","fields":["header.description_of_change","bom.existing_child.part_number","bom.new_child.part_number"],"severity":"BLOCKER","gate_effect":"FAIL","message":"The part mentioned in description of change is not found in BOM rows"},
    {"id":"S03","domain":"SEMANTIC_ALIGNMENT","scope":"description_to_bom","evaluator":"semantic_heuristic","check":"description_actions_match_bom_actions","fields":["header.description_of_change","bom.action","bom.task_number"],"severity":"ADVISORY","gate_effect":"NONE","message":"Change action does not match in description of change and BOM task"},
    {"id":"S04","domain":"SEMANTIC_ALIGNMENT","scope":"description_to_bom","evaluator":"semantic_heuristic","check":"affected_products_match_bom_assemblies","fields":["header.products_affected","bom.parent.part_number"],"severity":"ADVISORY","gate_effect":"NONE","message":"Products Affected does not align with assemblies in BOM"},
    {"id":"S05","domain":"BOM_LINE","scope":"bom_line","evaluator":"llm_advisory","check":"description_starts_with_noun_or_abbreviation","field":"bom.new_child.description","severity":"ADVISORY","gate_effect":"NONE","message":"Part description does not start with a noun, naming word, or an abbreviation"},
    {"id":"D01","domain":"PART_MASTER","scope":"bom_line","evaluator":"reference_lookup","applies_when":{"field":"bom.action","operator":"equals","value":"ADD"},"check":"new_part_exists_or_has_pending_master_change","field":"bom.new_child.part_number","references":["reference.parts","reference.part_master_changes"],"severity":"BLOCKER","gate_effect":"FAIL","message":"Part number not found in Parts Master DB"},
    {"id":"D02","domain":"PART_MASTER","scope":"bom_line","evaluator":"reference_lookup","applies_when":{"field":"bom.action","operator":"equals","value":"ADD"},"check":"reference_status_equals","field":"bom.new_child.part_number","reference":"reference.parts.status","parameters":{"expected":"ACTIVE"},"severity":"BLOCKER","gate_effect":"FAIL","message":"Part has OBSOLETE primary role, cannot be used as new part"},
    {"id":"D03","domain":"PART_MASTER","scope":"part","evaluator":"reference_lookup","applies_when":{"field":"reference.parts.primary_role","operator":"not_equals","value":"PU"},"check":"reference_field_required","field":"reference.parts.supplier","severity":"BLOCKER","gate_effect":"FAIL","message":"No supplier recorded for this part in Parts Master DB"},
    {"id":"D04","domain":"COMPLIANCE","scope":"part","evaluator":"reference_lookup","applies_when":{"field":"reference.parts.safety_critical","operator":"equals","value":true},"check":"approval_present","field":"reference.approvals.quality","severity":"ADVISORY","gate_effect":"REVIEW","message":"Safety-critical part detected, Quality team approval required before ECN can proceed"}
  ]
}
