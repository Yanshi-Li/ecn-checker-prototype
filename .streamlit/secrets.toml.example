# Copy to .streamlit/secrets.toml for local Streamlit development, or add these
# values in Streamlit Community Cloud Settings -> Secrets. Do not commit real keys.

# Required to unlock the Streamlit interface. Use a long, unique password.
APP_PASSWORD = "replace-with-a-strong-password"

OPENAI_API_KEY = "your-openai-api-key"
OPENAI_MODEL = "gpt-4o-mini"
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

SENDGRID_API_KEY = "your-sendgrid-api-key"
EMAIL_FROM_ADDRESS = "verified-sender@example.com"
# Keep true unless notification delivery has been explicitly approved.
DRY_RUN = true
