# Copy this file to .env and fill in your actual keys.
# Never commit the real .env file.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://gateway.aitools.corp.fisherpaykel.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Proofpoint Secure Email Relay (SER)
PROOFPOINT_TOKEN_URL=https://mail-us.ser.proofpoint.com/v1/token
PROOFPOINT_SEND_URL=https://mail-us.ser.proofpoint.com/v1/send

PROOFPOINT_CLIENT_ID=
PROOFPOINT_CLIENT_SECRET=

PROOFPOINT_SENDER_ADDRESS=ai-ecn-notifications@fisherpaykel.com
PROOFPOINT_HEADER_FROM_EMAIL=ai-ecn-notifications@fisherpaykel.com

PROOFPOINT_TOKEN_GRANT_TYPE=client_credentials
PROOFPOINT_TOKEN_SCOPE=
PROOFPOINT_TOKEN_AUDIENCE=
PROOFPOINT_TOKEN_RESPONSE_FIELD=access_token
PROOFPOINT_TOKEN_CLIENT_ID_FIELD=client_id
PROOFPOINT_TOKEN_CLIENT_SECRET_FIELD=client_secret
PROOFPOINT_TOKEN_GRANT_TYPE_FIELD=grant_type
PROOFPOINT_TOKEN_SCOPE_FIELD=
PROOFPOINT_TOKEN_AUDIENCE_FIELD=
PROOFPOINT_TOKEN_REQUEST_FORMAT=form
PROOFPOINT_SEND_REQUEST_FORMAT=json

ECN_APP_URL=